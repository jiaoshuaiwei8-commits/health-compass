# ---------------------------------------------------------------------------
# 数据库
# ---------------------------------------------------------------------------
# 有 Postgres 时填写；留空则自动使用内置的 PGlite（本地文件数据库，开箱即用）
# DATABASE_URL=postgres://health:health@localhost:5432/health_compass
PGLITE_DATA_DIR=.pglite

# ---------------------------------------------------------------------------
# 会话签名密钥（生产环境必须替换为随机 32 字节以上字符串）
# ---------------------------------------------------------------------------
AUTH_SECRET=dev-only-secret-please-change-me-32-chars

# ---------------------------------------------------------------------------
# AI 报告生成
#   mock      = 不调用大模型，用规则引擎 + 知识库片段生成报告（可离线跑通全链路）
#   deepseek  = 调用 DeepSeek Chat Completions
# ---------------------------------------------------------------------------
AI_PROVIDER=mock
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ---------------------------------------------------------------------------
# 向量检索
#   hash    = 本地字符 n-gram 哈希向量（无需联网，开发默认）
#   bailian = 阿里云百炼 text-embedding-v4（1024 维）
# 注意：知识库入库与查询必须使用同一种向量方式，切换后需重新执行 npm run kb:ingest
# ---------------------------------------------------------------------------
EMBEDDING_PROVIDER=hash
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4

# ---------------------------------------------------------------------------
# 限流
# ---------------------------------------------------------------------------
REPORTS_PER_DAY=2
